# Contoh env produksi VPS — nama variabel saja, TANPA nilai.
# File nyata: /opt/crypastra/config/crypastra.env (izin 600, TIDAK di git).
# compose.yaml memuatnya lewat `env_file`.

# ── Universe & durasi recorder ──────────────────────────────────────────
# tools/record-market.ts membaca --contracts/--seconds sebagai flag CLI
# (lihat compose.yaml command override), bukan env — baris ini didokumentasi
# di sini karena deploy-vps.sh membacanya untuk menyusun argumen.
CRYPASTRA_CONTRACTS=BTC_USDT,ETH_USDT

# ── Database (dalam container; volume named crypastra-data → /data) ────
CRYPASTRA_DB_PATH=/data/research.db

# ── Kebijakan perekaman (Phase 13.1) ──────────────────────────────────
# full = perilaku lama (semua quote change terekam; boros ~1.3GB/hari).
# research-compact = hemat: SEMUA candle tertutup + funding tetap, tetapi
# quote/mark dibatasi 1/detik/kontrak (coalescing deterministik, tanpa
# nilai karangan). BUKAN replay tick-perfect. Kebijakan terekam di metadata
# sesi; ganti kebijakan = sesi baru (sesi lama diabort, data dipertahankan).
CRYPASTRA_RECORDING_POLICY=research-compact

# ── Mode koleksi (bagian N, Q) ──────────────────────────────────────────
# 0 = RECORD ONLY (default aman). 1 = RECORD + COLLECT — HANYA setelah
# smoke:jev lulus dan diminta eksplisit.
CRYPASTRA_JEV=0

# ── Jev (Real Evaluator) — wajib diisi HANYA saat mengaktifkan COLLECT ──
# Jangan isi baris di bawah sampai smoke:jev dijalankan dan lulus.
CRYPASTRA_JEV_BASE_URL=
CRYPASTRA_JEV_API_KEY=
CRYPASTRA_JEV_MODEL=
CRYPASTRA_JEV_TIMEOUT_MS=8000
CRYPASTRA_JEV_QUEUE=200
CRYPASTRA_JEV_CONCURRENCY=2
CRYPASTRA_JEV_RPM=60
